# =============================================================================
# SiteFlow — Environment Variables
# Copy to .env and adjust. NEVER commit real secrets.
# =============================================================================

# Database
DATABASE_URL=postgresql://siteflow:siteflow_dev_password@127.0.0.1:5434/siteflow?schema=public

# API
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,exp://127.0.0.1:8081

# JWT (generate strong random secrets for production)
JWT_ACCESS_SECRET=change-me-access-secret-dev-only-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Password reset (token TTL in minutes)
PASSWORD_RESET_TTL_MINUTES=60

# SMTP (optional — without SMTP, resets are logged + returned as devResetToken in non-production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SiteFlow <noreply@siteflow.local>

# File storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/uploads
MAX_UPLOAD_BYTES=10485760

# S3-compatible (MinIO for local). Set STORAGE_PROVIDER=s3 and start: docker compose up -d minio minio-init
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=siteflow-uploads
S3_ACCESS_KEY=siteflow
S3_SECRET_KEY=siteflow_minio_dev
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=3600

# Admin (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Mobile (Expo) — use your machine LAN IP for physical devices
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Seed (development only — never use in production)
SEED_ADMIN_EMAIL=admin@siteflow.local
SEED_ADMIN_PASSWORD=SiteFlow@Admin123
